# Copy to .env (git-ignored) and adjust. All values are optional in development.

NODE_ENV=development
HOST=localhost
PORT=3333

# Empty → in-memory MongoDB replica set (data resets on restart).
# Docker:  mongodb://localhost:27017/neobank?replicaSet=rs0&directConnection=true
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neobank
MONGODB_URI=

# Signs access tokens. Required (32+ chars) in production; a dev default is used otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Encrypts 2FA (authenticator) secrets in MongoDB. Required (32+ chars) in production.
# Changing it later makes existing 2FA setups unreadable.
MFA_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Max login/register/refresh requests per IP per 15 minutes.
AUTH_RATE_LIMIT=20

# Demo users with 6 months of history (demo@neobank.dev / Demo@1234).
# Default: on in development, off otherwise.
SEED_DEMO_DATA=

# Admin user created on startup. Development defaults to Admin@1234;
# in production there is no admin unless ADMIN_PASSWORD is set.
ADMIN_EMAIL=admin@neobank.dev
ADMIN_PASSWORD=
