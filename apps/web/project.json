{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "nb",
  "sourceRoot": "apps/web/src",
  "tags": ["scope:web", "type:app"],
  "i18n": {
    "sourceLocale": {
      "code": "en-IN",
      "subPath": "en"
    },
    "locales": {
      "hi": {
        "translation": "apps/web/src/locale/messages.hi.json",
        "subPath": "hi"
      }
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web",
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          }
        ],
        "styles": [
          "node_modules/bootstrap/dist/css/bootstrap.min.css",
          "apps/web/src/styles.scss"
        ],
        "polyfills": ["@angular/localize/init"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/web/ui/src/lib/styles"]
        },
        "server": "apps/web/src/main.server.ts",
        "outputMode": "static",
        "localize": true,
        "i18nMissingTranslation": "error"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "800kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "localize": false
        },
        "development-hi": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "localize": ["hi"]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4200,
        "proxyConfig": "apps/web/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        },
        "hi": {
          "buildTarget": "web:build:development-hi"
        }
      },
      "dependsOn": ["api:serve"]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "web:build",
        "port": 4200,
        "staticFilePath": "dist/apps/web/browser",
        "spa": true
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "web:build",
        "format": "json",
        "outputPath": "apps/web/src/locale"
      }
    }
  }
}
