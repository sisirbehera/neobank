{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@neobank/shared/models": ["./libs/shared/models/src/index.ts"],
      "@neobank/shared/utils": ["./libs/shared/utils/src/index.ts"],
      "@neobank/web/ui": ["./libs/web/ui/src/index.ts"],
      "@neobank/web/ui/theme": ["./libs/web/ui/src/theme.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
